# Database
DATABASE_URL=postgresql+asyncpg://agriflow:agriflow@db:5432/agriflow
DATABASE_URL_SYNC=postgresql://agriflow:agriflow@db:5432/agriflow

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Frontend
FRONTEND_URL=http://localhost:5173

# Storage
STORAGE_BUCKET=agriflow-datasets
UPLOAD_DIR=./uploads
SUPABASE_URL=
SUPABASE_KEY=

# Gemini AI (Intelligence Agent)
# Get your free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
